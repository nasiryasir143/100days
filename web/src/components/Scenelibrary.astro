<section class="mx-auto max-w-6xl px-6 py-10 text-slate-100">
  <div class="rounded-2xl border border-slate-700 bg-slate-900 p-6">
    <p class="text-sm text-cyan-400">100 DAYS AI STUDIO</p>
    <h2 class="mt-2 text-3xl font-semibold">Scene Library</h2>
    <p class="mt-3 text-slate-400">
      Save and organize your scenes separately from characters.
    </p>

    <form id="scene-form" class="mt-6 grid gap-4">
      <label class="grid gap-2">
        Scene Name
        <input id="scene-name" required
          placeholder="Example: Day 1 — Main Arena"
          class="rounded-lg border border-slate-700 bg-slate-800 p-3 text-white" />
      </label>

      <label class="grid gap-2">
        Scene Details
    
        <textarea id="scene-details" rows="3"
          placeholder="Location, background, lighting, camera angle"
          class="rounded-lg border border-slate-700 bg-slate-800 p-3 text-white"></textarea>
          </label>

      <label class="grid gap-2">
        Scene Image
        <input id="scene-image" type="file" accept="image/png,image/jpeg,image/webp"
          class="rounded-lg border border-slate-700 bg-slate-800 p-3 text-white" />
        <span class="text-xs text-slate-400">PNG, JPG or WEBP · Maximum 8 MB</span>
      </label>

      <img id="scene-preview" alt="Scene preview"
        class="hidden max-h-72 w-full rounded-lg object-contain" />


      <button type="submit"
        class="rounded-lg bg-cyan-500 p-3 font-semibold text-slate-950">
        Save Scene
      </button>
    </form>

    <p id="scene-save-message" class="mt-3 text-sm" role="status"></p>

    <h3 class="mt-8 text-xl font-semibold">Saved Scenes</h3>
    <div id="scene-list" class="mt-4 grid gap-3"></div>
  </div>
</section>

<script>
(() => {
  const form = document.querySelector("#scene-form");
  const list = document.querySelector("#scene-list");
  const message = document.querySelector("#scene-save-message");
  const imageInput = document.querySelector("#scene-image");
  const preview = document.querySelector("#scene-preview");
  let selectedImage = "";
  const storageKey = "100days-scenes";

  if (!form || !list || !message) return;
  function getScenes() {
    const data = localStorage.getItem(storageKey);
    return data ? JSON.parse(data) : [];
  }

  function compressImage(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();

      reader.onload = () => {
        const img = new Image();

        img.onload = () => {
          const canvas = document.createElement("canvas");
          const scale = Math.min(1, 1200 / Math.max(img.width, img.height));

          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);

          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

          resolve(canvas.toDataURL("image/jpeg", 0.78));
        };

        img.onerror = reject;
        img.src = reader.result;
      };

      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  imageInput.addEventListener("change", async () => {
    const file = imageInput.files[0];

    if (!file) return;

    if (!["image/png", "image/jpeg", "image/webp"].includes(file.type)) {
      message.textContent = "Please select PNG, JPG or WEBP.";
      imageInput.value = "";
      return;
    }

    if (file.size > 8 * 1024 * 1024) {
      message.textContent = "Image must be smaller than 8 MB.";
      imageInput.value = "";
      return;
    }

    try {
      selectedImage = await compressImage(file);
      preview.src = selectedImage;
      preview.classList.remove("hidden");
      message.textContent = "Image ready.";
    } catch {
      message.textContent = "Could not process this image.";
    }
  });
  function renderScenes() {
    try {
      const scenes = getScenes();
      list.innerHTML = "";

      scenes.forEach((scene, index) => {
        const card = document.createElement("article");
        card.className = "rounded-lg border border-slate-700 bg-slate-800 p-4";

        const title = document.createElement("h4");
        title.className = "font-semibold text-cyan-300";
        title.textContent = scene.name;

        const details = document.createElement("p");
        details.className = "mt-2 whitespace-pre-wrap text-slate-300";
        details.textContent = scene.details || "No details added.";

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "mt-3 rounded bg-slate-700 px-3 py-2 text-sm";
        remove.textContent = "Delete";

        remove.addEventListener("click", () => {
          const updated = getScenes();
          updated.splice(index, 1);
          localStorage.setItem(storageKey, JSON.stringify(updated));
          message.textContent = "Scene deleted.";
          renderScenes();
        });
        if (scene.image) {
        const image = document.createElement("img");
        image.src = scene.image;
        image.alt = scene.name;
        image.className = "mt-3 max-h-72 w-full rounded-lg object-contain";
  card.append(image);
}
        card.append(title, details, remove);
        list.append(card);
      });

      if (!scenes.length) {
        list.textContent = "No scenes saved yet.";
      }
    } catch {
      message.textContent = "Could not load saved scenes.";
    }
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    try {
      const name = document.querySelector("#scene-name").value.trim();
      const details = document.querySelector("#scene-details").value.trim();

      if (!name) {
        message.textContent = "Please enter a scene name.";
        return;
      }

      const scenes = getScenes();
      scenes.push({ name, details, image: selectedImage });
      localStorage.setItem(storageKey, JSON.stringify(scenes));

      message.textContent = "Scene saved successfully!";
      form.reset();
      renderScenes();
    } catch {
      message.textContent = "Save failed. Browser storage may be unavailable.";
    }
  });

  renderScenes();
})();
</script>
