
---
const title = "Character Library";
---

<section class="mx-auto max-w-6xl px-6 py-10 text-slate-100">
  <div class="rounded-2xl border border-slate-700 bg-slate-900 p-6">
    <p class="text-sm text-cyan-400">100 DAYS AI STUDIO</p>
    <h2 class="mt-2 text-3xl font-semibold">Character Library</h2>
    <p class="mt-3 text-slate-400">
      Save your characters and keep their details organized for future scenes.
    </p>

    <form id="character-form" class="mt-6 grid gap-4">
      <label class="grid gap-2">
        Character Name
        <input id="character-name" required placeholder="Enter character name"
          class="rounded-lg border border-slate-700 bg-slate-800 p-3 text-white" />
      </label>

      <label class="grid gap-2">
        Character Number
        <input id="character-number" placeholder="Example: 001"
          class="rounded-lg border border-slate-700 bg-slate-800 p-3 text-white" />
      </label>

      <label class="grid gap-2">
        Character Details
        <textarea id="character-details" rows="3"
          placeholder="Appearance, clothes, and other details"
          class="rounded-lg border border-slate-700 bg-slate-800 p-3 text-white"></textarea>
      </label>

      <button type="submit"
        class="rounded-lg bg-cyan-500 p-3 font-semibold text-slate-950">
        Save Character
      </button>
    </form>

    <h3 class="mt-8 text-xl font-semibold">Saved Characters</h3>
    <div id="character-list" class="mt-4 grid gap-3"></div>
  </div>
</section>

<script>
  const form = document.querySelector("#character-form");
  const list = document.querySelector("#character-list");
  const storageKey = "100days-characters";

  function renderCharacters() {
    const characters = JSON.parse(localStorage.getItem(storageKey) || "[]");
    list.innerHTML = "";

    characters.forEach((character, index) => {
      const card = document.createElement("article");
      card.className = "rounded-lg border border-slate-700 bg-slate-800 p-4";

      const name = document.createElement("h4");
      name.className = "font-semibold text-cyan-300";
      name.textContent = `${character.number ? character.number + " — " : ""}${character.name}`;

      const details = document.createElement("p");
      details.className = "mt-2 whitespace-pre-wrap text-slate-300";
      details.textContent = character.details || "No details added.";

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "mt-3 rounded bg-slate-700 px-3 py-2 text-sm";
      remove.textContent = "Delete";
      remove.addEventListener("click", () => {
        const updated = JSON.parse(localStorage.getItem(storageKey) || "[]");
        updated.splice(index, 1);
        localStorage.setItem(storageKey, JSON.stringify(updated));
        renderCharacters();
      });

      card.append(name, details, remove);
      list.append(card);
    });

    if (!characters.length) {
      list.textContent = "No characters saved yet.";
    }
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    const characters = JSON.parse(localStorage.getItem(storageKey) || "[]");
    characters.push({
      name: document.querySelector("#character-name").value.trim(),
      number: document.querySelector("#character-number").value.trim(),
      details: document.querySelector("#character-details").value.trim()
    });

    localStorage.setItem(storageKey, JSON.stringify(characters));
    form.reset();
    renderCharacters();
  });

  renderCharacters();
</script>
